FROM docker.io/library/node:24.21.0-bookworm-slim AS node

FROM docker.io/library/rust:1.100-slim-bookworm
RUN apt-get update \
 && apt-get install -y --no-install-recommends g++ cmake make python3 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm

# TypeScript dependencies live in /node_modules, outside the mounted repository.
COPY package.json package-lock.json /
RUN cd / && npm ci --no-audit --no-fund && npm cache clean --force

# /cache is a named volume shared by runs: cargo registry and port builds.
RUN mkdir -m 1777 /cache
ENV PATH=/node_modules/.bin:$PATH \
    CARGO_HOME=/cache/cargo \
    CARGO_TARGET_DIR=/cache/rust-target \
    CPP_BUILD_DIR=/cache/cpp-build
